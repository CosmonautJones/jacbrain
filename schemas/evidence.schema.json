{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JacBrain evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "content", "source_uri", "content_hash", "project", "jac_version", "status", "created_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "kind": {"enum": ["Concept", "Document", "Symbol", "Diagnostic", "Fix", "Pattern", "Task", "Validation"]},
    "content": {"type": "string", "minLength": 1},
    "source_uri": {"type": "string", "minLength": 1},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "project": {"type": "string", "minLength": 1},
    "jac_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["candidate", "compiler_validated", "superseded"]},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
